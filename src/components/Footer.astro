---
import club from '../data/club.json';
const year = new Date().getFullYear();
---
<footer class="bg-slate-100 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-8 grid gap-6 sm:grid-cols-3 text-sm">
    <div>
      <h2 class="font-semibold text-stone">{club.name}</h2>
      <p>Founded {club.founded}</p>
    </div>
    <div>
      <h2 class="font-semibold text-stone">Find us</h2>
      <p>{club.rink}<br/>{club.address}</p>
    </div>
    <div>
      <h2 class="font-semibold text-stone">Contact</h2>
      <p>
        <a class="underline hover:text-accent" href={`mailto:${club.email}`}>
          {club.email}
        </a>
      </p>
    </div>
  </div>
  <p class="text-center text-xs py-4 text-slate-500">© {year} {club.name}</p>
</footer>
