---
import club from '../data/club.json';
const year = new Date().getFullYear();
---
<footer class="bg-slate-100 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-8 grid gap-6 sm:grid-cols-3 text-sm">
    <div>
      <h2 class="font-semibold text-stone">{club.name}</h2>
      <p>Founded {club.founded}</p>
    </div>
    <div>
      <h2 class="font-semibold text-stone">Find us</h2>
      <p>{club.rink}, {club.address}</p>
    </div>
    <div>
      <h2 class="font-semibold text-stone">Follow us</h2>
      <p>
        <a class="inline-flex items-center gap-1.5 hover:text-accent" href={club.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073c0 6.025 4.388 11.022 10.125 11.927v-8.437H7.078v-3.49h3.047V9.412c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971h-1.513c-1.491 0-1.956.93-1.956 1.886v2.265h3.328l-.532 3.49h-2.796v8.437C19.612 23.095 24 18.098 24 12.073z"/></svg>
          Facebook
        </a>
      </p>
    </div>
  </div>
  <p class="text-center text-xs py-4 text-slate-500">
    © {year} {club.name} · <a href="/privacy" class="underline hover:text-accent">Privacy</a>
  </p>
</footer>
