---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import club from "../data/club.json";
---

<BaseLayout
  title="Home"
  description="Bellshill Curling Club — a friendly Lanarkshire club playing at Hamilton Ice Rink since 1872. New members and beginners always welcome."
>
  <section class="bg-ice">
    <div class="max-w-6xl mx-auto px-4 py-20 text-center">
      <img
        src="/images/bellshill-logo.png"
        alt={`${club.name} crest`}
        class="mx-auto mb-6 h-32 sm:h-40 md:h-48 w-auto"
        width="400"
        height="400"
      />
      <h1 class="text-4xl sm:text-5xl font-bold text-stone">
        Welcome to {club.name}
      </h1>
      <p class="mt-4 text-lg max-w-2xl mx-auto">
        A friendly curling club based in Lanarkshire, welcoming players of all
        abilities since {club.founded}.
      </p>
      <div class="mt-8">
        <Button href="/contact/">Join the club</Button>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16 grid gap-6 md:grid-cols-3">
    <Card title="Where we play">
      <p>{club.rink}, {club.address}</p>
    </Card>
    <Card title="Season">
      <p>We curl from {club.season} every year.</p>
    </Card>
    <Card title="Friendly & welcoming">
      <p>
        Players of all ages and abilities are part of the club, from complete
        beginners to seasoned curlers. New members are always welcome.
      </p>
    </Card>
  </section>

  <section class="bg-slate-50">
    <div
      class="max-w-6xl mx-auto px-4 py-16 grid gap-8 md:grid-cols-2 items-center"
    >
      <div>
        <h2 class="text-2xl font-bold text-stone mb-3">About the club</h2>
        <p class="mb-3">
          Bellshill Curling Club has been part of Lanarkshire's sporting
          community for over 150 years. We field teams across local and regional
          competitions, and pride ourselves on being a welcoming home for both
          seasoned curlers and complete beginners.
        </p>
        <p>
          <a class="underline text-stone hover:text-accent" href="/history/">
            Read our full history →
          </a>
        </p>
      </div>
      <div>
        <Card title="Never curled before?">
          <p class="mb-4">
            Curling is easier to try than you might think — no experience
            needed, just a sense of fun. Watch what a taster session looks like
            and find a Try Curling session near you.
          </p>
          <a
            class="font-semibold text-accent hover:text-orange-800"
            href="/try-curling/">Try Curling →</a
          >
        </Card>
      </div>
    </div>
  </section>
</BaseLayout>
