---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Page not found" description="The page you're looking for doesn't exist." noindex={true}>
  <section class="bg-ice">
    <div class="max-w-3xl mx-auto px-4 py-20 text-center">
      <h1 class="text-6xl font-bold text-stone">404</h1>
      <p class="mt-4 text-xl">Sorry, we couldn't find that page.</p>
      <p class="mt-2 text-gray-600">The page may have been moved or no longer exists.</p>
      <div class="mt-8">
        <Button href="/">Back to home</Button>
      </div>
    </div>
  </section>
</BaseLayout>
