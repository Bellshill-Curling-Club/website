---
import BaseLayout from "../layouts/BaseLayout.astro";
import scores from "../data/scores.json";
import competitions from "../data/competitions.json";

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });

const recent = [...scores].sort((a: any, b: any) =>
  b.date.localeCompare(a.date),
);

const resultLabel = (s: any) => {
  if (s.winner === 1) return "Win";
  if (s.winner === 2) return "Loss";
  return s.score1 > s.score2 ? "Win" : s.score1 < s.score2 ? "Loss" : "Draw";
};
const resultColour = (s: any) => {
  const label = resultLabel(s);
  return label === "Win"
    ? "text-green-700"
    : label === "Loss"
      ? "text-red-700"
      : "text-slate-600";
};
const isExternal = (s: any) => /bellshill/i.test(s.team1);

const tabs = [
  ...competitions.map((c: any) => ({ slug: c.slug, label: c.name })),
  { slug: "recent", label: "Recent Results" },
];
---

<BaseLayout
  title="Scores"
  description="Latest match results, internal competition standings and trophy winners for Bellshill Curling Club's league and cup competitions."
>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-stone mb-2">Scores</h1>
    <p class="text-slate-600 mb-6">
      Standings for our five internal club competitions, plus our latest
      external match results.
    </p>

    <div
      class="flex gap-2 border-b border-slate-200 mb-6 overflow-x-auto -mx-4 px-4 scrollbar-hide"
      role="tablist"
    >
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.slug}`}
            data-tab={t.slug}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`panel-${t.slug}`}
            tabindex={i === 0 ? 0 : -1}
            class:list={[
              "px-3 py-2 text-sm font-medium rounded-t-md transition-colors whitespace-nowrap",
              "border border-b-0 -mb-px",
              "aria-selected:bg-white aria-selected:border-slate-200 aria-selected:text-stone",
              "border-transparent text-slate-500 hover:text-stone",
            ]}
          >
            {t.label}
          </button>
        ))
      }
    </div>

    {
      competitions.map((c: any, i: number) => (
        <div
          role="tabpanel"
          id={`panel-${c.slug}`}
          aria-labelledby={`tab-${c.slug}`}
          data-panel={c.slug}
          class:list={["tab-panel", i === 0 ? "" : "hidden"]}
        >
          <header class="mb-4">
            <h2 class="text-2xl font-bold text-stone">{c.name}</h2>
            {c.subtitle && (
              <p class="text-sm uppercase tracking-wide text-slate-500">
                {c.subtitle}
              </p>
            )}
            <p class="text-sm text-slate-500">Season {c.season}</p>
          </header>

          {c.type === "round-robin" && c.players.length > 0 && (
            <div class="overflow-x-auto bg-white border border-slate-200 rounded-lg">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-slate-200">
                    <th scope="col" class="text-left px-4 py-3" />
                    {c.players.map((p: any) => (
                      <th
                        scope="col"
                        class="px-4 py-3 text-center font-semibold text-stone whitespace-nowrap"
                      >
                        {Array.isArray(p) ? (
                          <span class="block leading-tight">
                            {p.map((line: string) => (
                              <span class="block">{line}</span>
                            ))}
                          </span>
                        ) : (
                          p
                        )}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {c.rows.map((row: any) => (
                    <tr class="border-b border-slate-100 last:border-0">
                      <th
                        scope="row"
                        class="px-4 py-2 font-medium text-stone whitespace-nowrap"
                      >
                        {row.player}
                      </th>
                      {row.scores.map((s: string) => (
                        <td class="px-4 py-2 text-center font-semibold tabular-nums">
                          {s ? s : <span class="text-slate-300">———</span>}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
                {c.stats && c.stats.length > 0 && (
                  <tfoot class="bg-slate-50 border-t-2 border-slate-200">
                    {c.stats.map((stat: any) => {
                      const isPosition = /position/i.test(stat.label);
                      return (
                        <tr>
                          <th scope="row" class="px-4 py-2 text-slate-600">
                            {stat.label}
                          </th>
                          {stat.values.map((v: number) => (
                            <td
                              class:list={[
                                "px-4 py-2 text-center tabular-nums",
                                isPosition && v === 1
                                  ? "font-bold text-yellow-600"
                                  : "",
                              ]}
                            >
                              {isPosition && v === 1 ? `🏆 ${v}` : v}
                            </td>
                          ))}
                        </tr>
                      );
                    })}
                  </tfoot>
                )}
              </table>
            </div>
          )}

          {c.type === "knockout" && c.matches.length > 0 && (
            <div class="overflow-x-auto bg-white border border-slate-200 rounded-lg">
              <table class="w-full text-sm">
                <thead class="border-b border-slate-200">
                  <tr>
                    <th
                      scope="col"
                      class="text-left px-4 py-3 font-semibold text-stone"
                    >
                      Date
                    </th>
                    <th
                      scope="col"
                      class="text-left px-4 py-3 font-semibold text-stone"
                    >
                      Round
                    </th>
                    <th
                      scope="col"
                      class="text-right px-4 py-3 font-semibold text-stone"
                    >
                      Team
                    </th>
                    <th
                      scope="col"
                      class="text-center px-4 py-3 font-semibold text-stone"
                    >
                      Score
                    </th>
                    <th
                      scope="col"
                      class="text-left px-4 py-3 font-semibold text-stone"
                    >
                      Team
                    </th>
                    <th
                      scope="col"
                      class="text-center px-4 py-3 font-semibold text-stone"
                    >
                      Score
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {c.matches.map((m: any) => {
                    const isFinal = /^\s*final\s*$/i.test(m.round || "");
                    const trophy1 = isFinal && m.winner === 1 ? "🏆 " : "";
                    const trophy2 = isFinal && m.winner === 2 ? "🏆 " : "";
                    const winnerClass1 =
                      isFinal && m.winner === 1
                        ? "font-bold text-yellow-600"
                        : "font-medium";
                    const winnerClass2 =
                      isFinal && m.winner === 2
                        ? "font-bold text-yellow-600"
                        : "font-medium";
                    return (
                      <tr class="border-b border-slate-100 last:border-0">
                        <td class="px-4 py-2 text-slate-600 whitespace-nowrap">
                          {m.date}
                        </td>
                        <td class="px-4 py-2 text-slate-600">
                          {m.round || ""}
                        </td>
                        <td class:list={["px-4 py-2 text-right", winnerClass1]}>
                          {trophy1}
                          {m.team1}
                        </td>
                        <td class="px-4 py-2 text-center font-semibold tabular-nums">
                          {m.score1}
                        </td>
                        <td class:list={["px-4 py-2", winnerClass2]}>
                          {trophy2}
                          {m.team2}
                        </td>
                        <td class="px-4 py-2 text-center font-semibold tabular-nums">
                          {m.score2}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}

          {c.type === "singles" && c.groups && c.groups.length > 0 && (
            <div class="space-y-8">
              {c.intro && (
                <p class="text-slate-700 leading-relaxed max-w-3xl">
                  {c.intro}
                </p>
              )}

              <div class="grid gap-6 md:grid-cols-2">
                {c.groups.map((g: any) => (
                  <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
                    <h3 class="px-4 py-2 bg-slate-50 border-b border-slate-200 text-sm font-semibold text-stone">
                      {g.name}
                    </h3>
                    <div class="overflow-x-auto">
                      <table class="w-full text-sm">
                        <thead>
                          <tr class="border-b border-slate-200">
                            <th
                              scope="col"
                              class="text-left px-4 py-2 font-semibold text-stone"
                            >
                              Player
                            </th>
                            {c.columns.map((col: string) => (
                              <th
                                scope="col"
                                class="px-4 py-2 text-center font-semibold text-stone whitespace-nowrap"
                              >
                                {col}
                              </th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {g.rows.map((row: any) => (
                            <tr class="border-b border-slate-100 last:border-0">
                              <th
                                scope="row"
                                class="px-4 py-2 font-medium text-stone whitespace-nowrap text-left"
                              >
                                {row.player}
                              </th>
                              {row.values.map((v: any, vi: number) => {
                                const isPos = vi === row.values.length - 1;
                                const isWinner = isPos && v === 1;
                                return (
                                  <td
                                    class:list={[
                                      "px-4 py-2 text-center tabular-nums whitespace-nowrap",
                                      isWinner
                                        ? "font-bold text-yellow-600"
                                        : "",
                                    ]}
                                  >
                                    {isWinner ? `🏆 ${v}` : v}
                                  </td>
                                );
                              })}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                ))}
              </div>

              {c.bracket && (
                <div>
                  <h3 class="text-xl font-bold text-stone mb-3">Play-offs</h3>
                  <div class="bg-white border border-slate-200 rounded-lg overflow-x-auto">
                    <table class="w-full text-sm">
                      <thead class="border-b border-slate-200">
                        <tr>
                          <th
                            scope="col"
                            class="text-left px-4 py-3 font-semibold text-stone"
                          >
                            Round
                          </th>
                          <th
                            scope="col"
                            class="text-right px-4 py-3 font-semibold text-stone"
                          >
                            Player
                          </th>
                          <th
                            scope="col"
                            class="text-center px-4 py-3 font-semibold text-stone"
                          >
                            Score
                          </th>
                          <th
                            scope="col"
                            class="text-left px-4 py-3 font-semibold text-stone"
                          >
                            Player
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {[
                          ...(c.bracket.quarterFinals || []).map((m: any) => ({
                            ...m,
                            round: "Quarter-final",
                          })),
                          ...(c.bracket.semiFinals || []).map((m: any) => ({
                            ...m,
                            round: "Semi-final",
                          })),
                          ...(c.bracket.final
                            ? [{ ...c.bracket.final, round: "Final" }]
                            : []),
                        ].map((m: any) => {
                          const isFinal = m.round === "Final";
                          const w1 = m.winner === 1;
                          const w2 = m.winner === 2;
                          const cls1 =
                            isFinal && w1
                              ? "font-bold text-yellow-600"
                              : w1
                                ? "font-semibold text-stone"
                                : "text-slate-600";
                          const cls2 =
                            isFinal && w2
                              ? "font-bold text-yellow-600"
                              : w2
                                ? "font-semibold text-stone"
                                : "text-slate-600";
                          return (
                            <tr class="border-b border-slate-100 last:border-0">
                              <td class="px-4 py-2 text-slate-600 whitespace-nowrap">
                                {m.round}
                              </td>
                              <td
                                class:list={[
                                  "px-4 py-2 text-right whitespace-nowrap",
                                  cls1,
                                ]}
                              >
                                {isFinal && w1 ? "🏆 " : ""}
                                {m.team1}
                              </td>
                              <td class="px-4 py-2 text-center font-semibold tabular-nums whitespace-nowrap">
                                {m.score}
                              </td>
                              <td
                                class:list={[
                                  "px-4 py-2 whitespace-nowrap",
                                  cls2,
                                ]}
                              >
                                {isFinal && w2 ? "🏆 " : ""}
                                {m.team2}
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                  {c.bracket.final?.notes && (
                    <p class="text-sm text-slate-600 italic mt-3">
                      {c.bracket.final.notes}
                    </p>
                  )}
                </div>
              )}
            </div>
          )}

          {((c.type === "round-robin" && c.players.length === 0) ||
            (c.type === "knockout" && c.matches.length === 0) ||
            (c.type === "singles" && (!c.groups || c.groups.length === 0))) && (
            <p class="text-slate-500 italic">
              Results will appear here once the competition is under way.
            </p>
          )}
        </div>
      ))
    }

    <div
      role="tabpanel"
      id="panel-recent"
      aria-labelledby="tab-recent"
      data-panel="recent"
      class="tab-panel hidden"
    >
      <h2 class="text-2xl font-bold text-stone mb-4">Recent Results</h2>
      {
        recent.length === 0 ? (
          <p>No results recorded yet this season.</p>
        ) : (
          <ul class="space-y-3">
            {recent.map((s: any) => (
              <li class="flex items-center justify-between border border-slate-200 rounded-lg p-4 bg-white">
                <div>
                  <p class="font-semibold">
                    {s.team1} v {s.team2}
                  </p>
                  <p class="text-sm text-slate-500">
                    {fmt(s.date)} · {s.competition}
                  </p>
                </div>
                <div class="text-right">
                  <div
                    class:list={[
                      "text-xl font-bold",
                      isExternal(s) ? resultColour(s) : "text-stone",
                    ]}
                  >
                    {s.score1} – {s.score2}
                  </div>
                  {isExternal(s) && (
                    <div
                      class:list={[
                        "text-xs uppercase tracking-wide",
                        resultColour(s),
                      ]}
                    >
                      {resultLabel(s)}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]");

  function activate(slug: string, focus = false) {
    tabs.forEach((t) => {
      const selected = t.dataset.tab === slug;
      t.setAttribute("aria-selected", selected ? "true" : "false");
      t.setAttribute("tabindex", selected ? "0" : "-1");
      if (focus && selected) t.focus();
    });
    panels.forEach((p) =>
      p.classList.toggle("hidden", p.dataset.panel !== slug),
    );
    if (history.replaceState) {
      history.replaceState(null, "", `#${slug}`);
    }
  }

  tabs.forEach((t) =>
    t.addEventListener("click", () => activate(t.dataset.tab!)),
  );

  // Arrow-key navigation between tabs (WCAG 2.1.1 / APG tabs pattern)
  const tabList = document.querySelector<HTMLElement>("[role=tablist]");
  tabList?.addEventListener("keydown", (e) => {
    const tabArr = Array.from(tabs);
    const idx = tabArr.findIndex(
      (t) =>
        t.dataset.tab ===
        document.querySelector<HTMLButtonElement>("[aria-selected=true]")
          ?.dataset.tab,
    );
    let next = idx;
    if (e.key === "ArrowRight") next = (idx + 1) % tabArr.length;
    else if (e.key === "ArrowLeft")
      next = (idx - 1 + tabArr.length) % tabArr.length;
    else if (e.key === "Home") next = 0;
    else if (e.key === "End") next = tabArr.length - 1;
    else return;
    e.preventDefault();
    activate(tabArr[next].dataset.tab!, true);
  });

  const initial = location.hash.replace("#", "");
  if (initial && document.querySelector(`[data-panel="${initial}"]`)) {
    activate(initial);
  }
</script>
