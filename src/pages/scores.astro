---
import BaseLayout from '../layouts/BaseLayout.astro';
import scores from '../data/scores.json';

const fmt = (d) =>
  new Date(d).toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });

const recent = [...scores].sort((a, b) => b.date.localeCompare(a.date));

const resultLabel = (s) =>
  s.us > s.them ? 'Win' : s.us < s.them ? 'Loss' : 'Draw';
const resultColour = (s) =>
  s.us > s.them ? 'text-green-700' : s.us < s.them ? 'text-red-700' : 'text-slate-600';
---
<BaseLayout
  title="Scores"
  description="Recent match results for Bellshill Curling Club."
>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-stone mb-6">Recent Results</h1>

    {recent.length === 0 ? (
      <p>No results recorded yet this season.</p>
    ) : (
      <ul class="space-y-3">
        {recent.map((s) => (
          <li class="flex items-center justify-between border border-slate-200 rounded-lg p-4 bg-white">
            <div>
              <p class="font-semibold">vs {s.opponent}</p>
              <p class="text-sm text-slate-500">
                {fmt(s.date)} · {s.competition}
              </p>
            </div>
            <div class="text-right">
              <div class:list={['text-xl font-bold', resultColour(s)]}>
                {s.us} – {s.them}
              </div>
              <div class:list={['text-xs uppercase tracking-wide', resultColour(s)]}>
                {resultLabel(s)}
              </div>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
