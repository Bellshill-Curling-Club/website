---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import club from '../data/club.json';

const { officeBearers, members } = club.committee;
---
<BaseLayout
  title="Committee"
  description="Meet the committee of Bellshill Curling Club — office bearers and members."
>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-stone mb-2">Our Committee</h1>
    <p class="mb-8">
      The club is run by a volunteer Executive Committee elected at the
      Annual General Meeting. To get in touch with any member of the
      committee, please use our <a class="underline text-stone hover:text-accent" href="/contact">contact form</a>
      and your message will be passed on.
    </p>

    <h2 class="text-2xl font-semibold text-stone mb-4">Office bearers</h2>
    <div class="grid gap-4 sm:grid-cols-2 mb-10">
      {officeBearers.map((p) => (
        <Card title={p.role}>
          <p>{p.name}</p>
        </Card>
      ))}
    </div>

    <h2 class="text-2xl font-semibold text-stone mb-4">Committee members</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {members.map((m) => (
        <Card title={m.name}>
          {m.note && <p class="text-sm text-slate-600">{m.note}</p>}
        </Card>
      ))}
    </div>

    <p class="mt-10 text-sm text-slate-600">
      Interested in how the club is run? Read our
      <a class="underline text-stone hover:text-accent" href="/constitution">constitution and rules</a>.
    </p>
  </section>
</BaseLayout>
