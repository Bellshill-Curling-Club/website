---
import BaseLayout from "../layouts/BaseLayout.astro";

const FORMSPREE_ENDPOINT = "https://formspree.io/f/xnjkoqpe";
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Bellshill Curling Club."
>
  <section class="max-w-xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-stone mb-2">Contact Us</h1>
    <p class="mb-6">
      Interested in joining or have a question? Send us a message using the form
      below and a committee member will get back to you.
    </p>

    <form
      id="contact-form"
      action={FORMSPREE_ENDPOINT}
      method="POST"
      class="space-y-4"
    >
      <div>
        <label for="name" class="block font-medium"
          >Name <span aria-hidden="true" class="text-red-600">*</span></label
        >
        <input
          id="name"
          name="name"
          type="text"
          required
          minlength="2"
          autocomplete="name"
          aria-required="true"
          class="mt-1 w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone"
        />
      </div>

      <div>
        <label for="email" class="block font-medium"
          >Email <span aria-hidden="true" class="text-red-600">*</span></label
        >
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          aria-required="true"
          class="mt-1 w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone"
        />
      </div>

      <div>
        <label for="message" class="block font-medium"
          >Message <span aria-hidden="true" class="text-red-600">*</span></label
        >
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          minlength="10"
          aria-required="true"
          class="mt-1 w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone"
        ></textarea>
      </div>

      <!-- Honeypot field for spam bots; real users won't see or fill this -->
      <input
        type="text"
        name="_gotcha"
        class="hidden"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <button
        type="submit"
        class="bg-accent text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone transition"
      >
        Send message
      </button>
    </form>
  </section>
</BaseLayout>
