---
import BaseLayout from "../layouts/BaseLayout.astro";

const FORMSPREE_ENDPOINT = "https://formspree.io/f/xnjkoqpe";
const TURNSTILE_SITE_KEY = "0x4AAAAAADueXPgFW17i4J3M";
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Bellshill Curling Club."
>
  <section class="max-w-xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-stone mb-2">Contact Us</h1>
    <p class="mb-6">
      Interested in joining or have a question? Send us a message using the form
      below and a committee member will get back to you.
    </p>

    <form id="contact-form" class="space-y-4">
      <div>
        <label for="name" class="block font-medium"
          >Name <span aria-hidden="true" class="text-red-600">*</span></label
        >
        <input
          id="name"
          name="name"
          type="text"
          required
          minlength="2"
          autocomplete="name"
          aria-required="true"
          class="mt-1 w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone"
        />
      </div>

      <div>
        <label for="email" class="block font-medium"
          >Email <span aria-hidden="true" class="text-red-600">*</span></label
        >
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          aria-required="true"
          class="mt-1 w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone"
        />
      </div>

      <div>
        <label for="message" class="block font-medium"
          >Message <span aria-hidden="true" class="text-red-600">*</span></label
        >
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          minlength="10"
          aria-required="true"
          class="mt-1 w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone"
        ></textarea>
      </div>

      <!-- Honeypot field for spam bots; real users won't see or fill this -->
      <input
        type="text"
        name="_gotcha"
        class="hidden"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <!-- Cloudflare Turnstile widget -->
      <div
        class="cf-turnstile"
        data-sitekey={TURNSTILE_SITE_KEY}
        data-theme="light"
      >
      </div>

      <button
        type="submit"
        class="bg-accent text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone transition disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Send message
      </button>

      <p
        id="form-status"
        role="status"
        aria-live="polite"
        class="text-sm min-h-[1.25rem]"
      >
      </p>
    </form>
  </section>

  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>

  <script
    is:inline
    define:vars={{ endpoint: FORMSPREE_ENDPOINT }}
  >
    (function () {
      const form = document.getElementById("contact-form");
      const status = document.getElementById("form-status");
      if (!form || !status) return;

      const setStatus = (message, kind) => {
        status.textContent = message;
        status.className = "text-sm min-h-[1.25rem]";
        if (kind === "ok") status.classList.add("text-green-700");
        if (kind === "err") status.classList.add("text-red-700");
      };

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        setStatus("", null);

        if (!form.checkValidity()) {
          setStatus("Please complete all fields correctly.", "err");
          form.reportValidity();
          return;
        }

        const data = new FormData(form);
        const token = data.get("cf-turnstile-response");
        if (!token) {
          setStatus("Please complete the challenge before sending.", "err");
          return;
        }

        try {
          const res = await fetch(endpoint, {
            method: "POST",
            body: data,
            headers: { Accept: "application/json" },
          });

          if (res.ok) {
            form.reset();
            if (window.turnstile) window.turnstile.reset();
            setStatus("Thanks! Your message has been sent.", "ok");
          } else {
            const body = await res.json().catch(() => null);
            console.error("Formspree error:", res.status, body);
            const msg =
              (body &&
                body.errors &&
                body.errors[0] &&
                body.errors[0].message) ||
              `Sorry, something went wrong (status ${res.status}). Please email us instead.`;
            setStatus(msg, "err");
          }
        } catch (_) {
          setStatus("Network error. Please try again later.", "err");
        }
      });
    })();
  </script>
</BaseLayout>
