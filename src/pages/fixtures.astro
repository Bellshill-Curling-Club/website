---
import BaseLayout from "../layouts/BaseLayout.astro";
import competitions from "../data/fixtures.json";

const fmtDate = (d) =>
  new Date(d).toLocaleDateString("en-GB", {
    weekday: "short",
    day: "2-digit",
    month: "short",
    year: "numeric",
  });

const today = new Date();
today.setHours(0, 0, 0, 0);

const isFourPlayerRink = (r) => r.skip || r.third || r.second || r.lead;

const tabs = competitions.map((c) => ({ slug: c.slug, label: c.name }));
---

<BaseLayout
  title="Fixtures"
  description="2025/26 fixtures, match schedules and competition dates for Bellshill Curling Club, playing internal and external games at Hamilton Ice Rink."
>
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-stone mb-2">2025/26 Fixtures</h1>
    <p class="text-slate-600 mb-6">
      All five club competitions in one place. Pick a competition to view its
      schedule, rinks and reserves.
    </p>

    <div
      class="flex gap-2 border-b border-slate-200 mb-6 overflow-x-auto -mx-4 px-4 scrollbar-hide"
      role="tablist"
    >
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.slug}`}
            data-tab={t.slug}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`panel-${t.slug}`}
            tabindex={i === 0 ? 0 : -1}
            class:list={[
              "px-3 py-2 text-sm font-medium rounded-t-md transition-colors whitespace-nowrap",
              "border border-b-0 -mb-px",
              "aria-selected:bg-white aria-selected:border-slate-200 aria-selected:text-stone",
              "border-transparent text-slate-500 hover:text-stone",
            ]}
          >
            {t.label}
          </button>
        ))
      }
    </div>

    {
      competitions.map((c, i) => (
        <div
          role="tabpanel"
          id={`panel-${c.slug}`}
          aria-labelledby={`tab-${c.slug}`}
          data-panel={c.slug}
          class:list={["tab-panel", i === 0 ? "" : "hidden"]}
        >
          <header class="mb-4">
            <h2 class="text-2xl font-bold text-stone">{c.name}</h2>
            {c.format && <p class="text-sm text-slate-600 mt-1">{c.format}</p>}
          </header>

          {c.rinks && c.rinks.length > 0 && (
            <div class="mb-6">
              <h3 class="text-lg font-semibold text-stone mb-2">Rinks</h3>
              <div class="overflow-x-auto bg-white border border-slate-200 rounded-lg">
                <table class="w-full text-sm">
                  <thead class="border-b border-slate-200">
                    {c.rinks.some(isFourPlayerRink) ? (
                      <tr>
                        <th class="text-left px-4 py-3" />
                        <th class="text-left px-4 py-3 font-semibold text-stone">
                          Skip
                        </th>
                        <th class="text-left px-4 py-3 font-semibold text-stone">
                          Third
                        </th>
                        <th class="text-left px-4 py-3 font-semibold text-stone">
                          Second
                        </th>
                        <th class="text-left px-4 py-3 font-semibold text-stone">
                          Lead
                        </th>
                      </tr>
                    ) : (
                      <tr>
                        <th class="text-left px-4 py-3" />
                        <th class="text-left px-4 py-3 font-semibold text-stone">
                          Players
                        </th>
                      </tr>
                    )}
                  </thead>
                  <tbody>
                    {c.rinks.map((r) => (
                      <tr class="border-b border-slate-100 last:border-0">
                        <th
                          scope="row"
                          class="text-left px-4 py-2 font-medium text-stone whitespace-nowrap"
                        >
                          {r.label}
                        </th>
                        {isFourPlayerRink(r) ? (
                          <>
                            <td class="px-4 py-2">{r.skip}</td>
                            <td class="px-4 py-2">{r.third}</td>
                            <td class="px-4 py-2">{r.second}</td>
                            <td class="px-4 py-2">{r.lead}</td>
                          </>
                        ) : (
                          <td class="px-4 py-2">
                            {(r.players || []).join(", ")}
                          </td>
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {c.reserves && c.reserves.length > 0 && (
                <p class="mt-3 text-sm text-slate-600">
                  <span class="font-semibold">Reserves:</span>{" "}
                  {c.reserves.join(", ")}
                </p>
              )}
            </div>
          )}

          <h3 class="text-lg font-semibold text-stone mb-2">Fixtures</h3>
          {c.fixtures && c.fixtures.length > 0 ? (
            <div class="overflow-x-auto bg-white border border-slate-200 rounded-lg">
              <table class="w-full text-sm">
                <thead class="border-b border-slate-200">
                  <tr>
                    <th class="text-left px-4 py-3 font-semibold text-stone">
                      Date
                    </th>
                    <th class="text-left px-4 py-3 font-semibold text-stone">
                      Time
                    </th>
                    <th class="text-left px-4 py-3 font-semibold text-stone">
                      Match
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {c.fixtures.map((f) => {
                    const past = new Date(f.date) < today;
                    return (
                      <tr
                        class={`border-b border-slate-100 last:border-0 ${past ? "text-slate-400" : ""}`}
                      >
                        <td class="px-4 py-2 whitespace-nowrap">
                          {fmtDate(f.date)}
                        </td>
                        <td class="px-4 py-2 whitespace-nowrap tabular-nums">
                          {f.time}
                        </td>
                        <td class="px-4 py-2">{f.match}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="text-slate-500 italic">No fixtures scheduled.</p>
          )}
        </div>
      ))
    }

    <p class="mt-8 text-sm text-slate-500">
      Fixtures are kept up to date by the match secretary. See the <a
        class="underline"
        href="/scores/">scores page</a
      > for past results and league standings.
    </p>
  </section>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]");

  function activate(slug: string, focus = false) {
    tabs.forEach((t) => {
      const selected = t.dataset.tab === slug;
      t.setAttribute("aria-selected", selected ? "true" : "false");
      t.setAttribute("tabindex", selected ? "0" : "-1");
      if (focus && selected) t.focus();
    });
    panels.forEach((p) =>
      p.classList.toggle("hidden", p.dataset.panel !== slug),
    );
    if (history.replaceState) {
      history.replaceState(null, "", `#${slug}`);
    }
  }

  tabs.forEach((t) =>
    t.addEventListener("click", () => activate(t.dataset.tab!)),
  );

  const tabList = document.querySelector<HTMLElement>("[role=tablist]");
  tabList?.addEventListener("keydown", (e) => {
    const tabArr = Array.from(tabs);
    const idx = tabArr.findIndex(
      (t) =>
        t.dataset.tab ===
        document.querySelector<HTMLButtonElement>("[aria-selected=true]")
          ?.dataset.tab,
    );
    let next = idx;
    if (e.key === "ArrowRight") next = (idx + 1) % tabArr.length;
    else if (e.key === "ArrowLeft")
      next = (idx - 1 + tabArr.length) % tabArr.length;
    else if (e.key === "Home") next = 0;
    else if (e.key === "End") next = tabArr.length - 1;
    else return;
    e.preventDefault();
    activate(tabArr[next].dataset.tab!, true);
  });

  const initial = location.hash.replace("#", "");
  if (initial && document.querySelector(`[data-panel="${initial}"]`)) {
    activate(initial);
  }
</script>
